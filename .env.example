# Inner base LLM (real provider). Do NOT point this at the CLOSER server.
CLOSER_BASE_URL=https://your-real-llm-endpoint/v1
CLOSER_API_KEY=replace-me
CLOSER_MODEL=your-base-model-id

# Outer CLOSER OpenAI-compatible server (what ProteinGym-LLM calls for harness eval).
CLOSER_SERVER_MODEL_ID=closer-v1
CLOSER_SERVER_HOST=127.0.0.1
CLOSER_SERVER_PORT=8099
CLOSER_SERVER_API_KEY=dummy-local-key
PGLLM_CLOSER_BASE_URL=http://127.0.0.1:8099/v1
PGLLM_CLOSER_API_KEY=dummy-local-key

# Direct OpenAI-compatible model eval (PG-LLM calls the provider directly).
PGLLM_OPENAI_BASE_URL=https://your-real-llm-endpoint/v1
PGLLM_OPENAI_API_KEY=replace-me
PGLLM_MODEL_ID=gpt-5.5
PGLLM_MODEL_ALIAS=gpt55
PGLLM_REASONING=high
PGLLM_MAX_TOKENS=4096
