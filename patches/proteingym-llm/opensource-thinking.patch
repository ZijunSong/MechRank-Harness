+def _redact_reasoning_chunk(chunk: Any) -> Any:
+    """Remove reasoning fields from one streamed or final chat payload chunk."""
+    if not isinstance(chunk, dict):
+        return chunk
+    redacted = dict(chunk)
+    choices = redacted.get("choices")
+    if not isinstance(choices, list):
+        return redacted
+    sanitized_choices: list[Any] = []
+    for choice in choices:
+        if not isinstance(choice, dict):
+            sanitized_choices.append(choice)
+            continue
+        sanitized_choice = dict(choice)
+        delta = sanitized_choice.get("delta")
+        if isinstance(delta, dict):
+            sanitized_delta = dict(delta)
+            sanitized_delta.pop("reasoning_content", None)
+            sanitized_choice["delta"] = sanitized_delta
+        message = sanitized_choice.get("message")
+        if isinstance(message, dict):
+            sanitized_message = dict(message)
+            sanitized_message.pop("reasoning_content", None)
+            sanitized_choice["message"] = sanitized_message
+        sanitized_choices.append(sanitized_choice)
+    redacted["choices"] = sanitized_choices
+    return redacted
+
+
+def sanitize_response_for_storage(response: dict, *, store_reasoning: bool) -> dict:
+    """Drop reasoning traces from stored provider payloads when configured."""
+    if store_reasoning:
+        return response
+    sanitized = dict(response)
+    sanitized["reasoning_text"] = None
+    content = sanitized.get("response_content")
+    if isinstance(content, list):
+        sanitized["response_content"] = [_redact_reasoning_chunk(item) for item in content]
+    elif isinstance(content, dict):
+        sanitized["response_content"] = _redact_reasoning_chunk(content)
+    provider = sanitized.get("provider_response")
+    if isinstance(provider, dict):
+        provider_copy = dict(provider)
+        chunks = provider_copy.get("chunks")
+        if isinstance(chunks, list):
+            provider_copy["chunks"] = [_redact_reasoning_chunk(item) for item in chunks]
+        sanitized["provider_response"] = provider_copy
+    return sanitized
+
+
